# 공공데이터포털 — ArpltnInforInqireSvc 일반 인증키
# 반드시 "디코딩" 키를 넣는다. 인코딩 키를 넣으면 이중 인코딩으로 인증이 깨진다 (PRD R1)
AIRKOREA_SERVICE_KEY=

# Google AI Studio — Gemini API 키
GEMINI_API_KEY=

# 선택 — 조언 모델 교체용. 비우면 gemini-3.7-flash를 쓴다
# (PRD가 적은 gemini-3.0-flash는 존재하지 않는 이름이다)
GEMINI_MODEL=

# 선택 — 마지막 정상값 공유 캐시 (Vercel KV / Upstash Redis REST)
# 상류 일일 한도를 소진했을 때 마지막 정상값으로 계속 서비스하기 위한 것이다.
# 없으면 인스턴스 메모리에만 두므로, 배포 환경에서는 콜드 스타트마다 비어 있다.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN 이름도 인식한다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
